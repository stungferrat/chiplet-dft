+                // used to be missing, so branch_ne was always 0 and BNE
+                // executed as BEQ -- it branched when the operands were
+                // EQUAL. The original tests never used BNE, so it went
+                // unnoticed. Only BEQ/BNE reach here (see legal).
+                branch_ne = (funct3 == 3'b001);
             end
             OP_JAL: begin
                 reg_write = 1'b1;
                 jump      = 1'b1;
             end
-            default: ; // NOP / unsupported -> all zero
+            default: ; // unreachable: legal=0 for any other opcode
         endcase
     end
 endmodule
