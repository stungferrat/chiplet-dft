 // -------------------------------------------------------------
 // Control Unit (combinational decode of opcode)
+//
+// Supported subset of RV32I (anything else executes as a NOP):
+//   R-type : ADD SUB AND OR XOR SLT SLL SRL SRA
+//   I-type : ADDI ANDI ORI XORI SLTI SLLI SRLI SRAI
+//   LW, SW, BEQ, BNE, JAL
 // -------------------------------------------------------------
 module control_unit (
     input  [6:0] opcode,
     input  [2:0] funct3,     // needed to tell BEQ (000) from BNE (001)
+    input  [6:0] funct7,     // needed to reject e.g. MUL (funct7=0000001)
     output reg reg_write,
     output reg mem_read,
     output reg mem_write,
@@ -154,8 +160,57 @@
     localparam OP_BRANCH = 7'b1100011;
     localparam OP_JAL    = 7'b1101111;
 
+    // -----------------------------------------------------------
+    // legal: 1 only for an instruction in the supported subset.
+    //
+    // WHAT THIS REPLACES: the decoder used to look at the opcode
+    // alone (plus funct3 for BEQ/BNE), so an unsupported
+    // instruction that shared an opcode with a supported one ran
+    // as that instruction:
+    //   SLTU/SLTIU -> ADD/ADDI      (funct3=011 fell to the ALU default)
+    //   BLT/BGE/BLTU/BGEU -> BEQ    (any branch funct3 other than 001)
+    //   LB/LH/LBU/LHU -> LW,  SB/SH -> SW
+    //   MUL etc. (funct7=0000001) -> the base op with the same funct3
+    // Unknown opcodes (LUI, AUIPC, JALR, FENCE, ECALL, all-zero
+    // word) were already NOPs.
+    //
+    // NOW: every field that tells supported from unsupported is
+    // checked, and an unsupported instruction is squashed to a NOP
+    // (no register write, no memory access, no branch). The core
+    // has no trap/exception logic, so a NOP is the safe, defined
+    // behaviour; it is NOT RISC-V compliant (the spec says raise
+    // an illegal-instruction exception) and the report should say
+    // so.
+    // -----------------------------------------------------------
+    reg legal;
+    always @(*) begin
+        case (opcode)
+            OP_RTYPE:
+                // funct7=0000000: ADD SLL SLT XOR SRL OR AND (not 011=SLTU)
+                // funct7=0100000: SUB (000) and SRA (101) only
+                legal = ((funct7 == 7'b0000000) && (funct3 != 3'b011)) ||
+                        ((funct7 == 7'b0100000) &&
+                         ((funct3 == 3'b000) || (funct3 == 3'b101)));
+            OP_ITYPE:
+                case (funct3)
+                    3'b011:  legal = 1'b0;                     // SLTIU
+                    3'b001:  legal = (funct7 == 7'b0000000);   // SLLI
+                    3'b101:  legal = (funct7 == 7'b0000000) ||  // SRLI
+                                     (funct7 == 7'b0100000);   // SRAI
+                    default: legal = 1'b1;  // ADDI SLTI XORI ORI ANDI:
+                                            // bits 31:25 are immediate
+                endcase
+            OP_LOAD,
+            OP_STORE:  legal = (funct3 == 3'b010);             // LW / SW only
+            OP_BRANCH: legal = (funct3 == 3'b000) ||           // BEQ
+                               (funct3 == 3'b001);             // BNE
+            OP_JAL:    legal = 1'b1;
+            default:   legal = 1'b0;
+        endcase
+    end
+
     always @(*) begin
-        // defaults
+        // defaults (also what an illegal instruction gets: a NOP)
         reg_write  = 1'b0;
         mem_read   = 1'b0;
         mem_write  = 1'b0;
@@ -166,7 +221,7 @@
         jump       = 1'b0;
