+        addi(0, 0, 11), add(1, 0, 0),                                  # MEM path
+        addi(0, 0, 12), addi(20, 0, 0), add(2, 0, 0),                  # WB path
+        addi(0, 0, 13), addi(20, 0, 0), addi(20, 0, 0), add(3, 0, 0),  # RF bypass
